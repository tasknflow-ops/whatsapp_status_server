{
  "expo": {
    "name": "Statusly: Status Downloader",
    "slug": "whatsapp-status-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#008BA4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.jeemil.statussaver",
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008BA4"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9290713243324092~2233174375"
        }
      ]
    ],
    "owner": "ayush_2001",
    "extra": {
      "eas": {
        "projectId": "eed0c273-e8cb-421f-9bd7-6db0cd8660a9"
      }
    }
  }
}
